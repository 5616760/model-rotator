# ---- Personal / local config -------------------------------------------------
# Your real config lives at config.json (copy from config.example.json and edit).
# It is intentionally NOT tracked so secrets and machine-specific paths never leak.
config.json

# ---- Logs --------------------------------------------------------------------
*.log
rotator.log

# ---- Backups -----------------------------------------------------------------
*.bak
*.bak*

# ---- Probe output (machine-specific capability scan) --------------------------
probe_result.json
probe_result.burst.json
quality_result.json
eval_run*.log
crash.log
r8.json

# ---- Deployed single-file exe (build artifact; releases live on GH Releases) --
ModelRotator.exe

# ---- Secrets / environment ---------------------------------------------------
.env

# ---- Python ------------------------------------------------------------------
__pycache__/
*.pyc
*.pyo

# ---- PyInstaller build artifacts ----------------------------------------------
build/
dist/
*.spec

# ---- OS / editor -------------------------------------------------------------
.DS_Store
Thumbs.db
.idea/
.vscode/
overrides.json
